{
  "name": "@database-framework-cloudflare/cloudflare-database-runtime",
  "version": "0.0.0",
  "description": "Cloudflare Durable Object host runtime for database-framework Embedded WASM applications.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./limits": {
      "types": "./src/DatabaseRuntimeLimits.ts",
      "import": "./src/DatabaseRuntimeLimits.ts"
    },
    "./runtime-connection": {
      "types": "./src/runtime-connection.ts",
      "import": "./src/runtime-connection.ts"
    },
    "./execution-failure": {
      "types": "./src/DatabaseExecutionFailure.ts",
      "import": "./src/DatabaseExecutionFailure.ts"
    },
    "./authorization": {
      "types": "./src/DatabaseAuthenticatedPrincipal.ts",
      "import": "./src/DatabaseAuthenticatedPrincipal.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test \"test/**/*.test.ts\"",
    "smoke:workerd": "node scripts/smoke-workerd-full-runtime.mjs"
  },
  "dependencies": {
    "@storage-kit/cloudflare-durable-object-storage-host": "file:../../../storage-kit/Workers/CloudflareDurableObjectStorageHost"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260723.1",
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
