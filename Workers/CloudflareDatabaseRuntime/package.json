{
  "name": "@database-framework-cloudflare/cloudflare-database-runtime",
  "version": "26.818.0",
  "description": "Cloudflare Durable Object host runtime for database-framework Embedded WASM applications.",
  "license": "MIT",
  "type": "module",
  "files": [
    "README.md",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1amageek/database-framework-cloudflare.git",
    "directory": "Workers/CloudflareDatabaseRuntime"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./limits": {
      "types": "./src/DatabaseRuntimeLimits.ts",
      "import": "./src/DatabaseRuntimeLimits.ts"
    },
    "./runtime-connection": {
      "types": "./src/runtime-connection.ts",
      "import": "./src/runtime-connection.ts"
    },
    "./execution-failure": {
      "types": "./src/DatabaseExecutionFailure.ts",
      "import": "./src/DatabaseExecutionFailure.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test \"test/**/*.test.ts\"",
    "smoke:workerd": "node scripts/smoke-workerd-full-runtime.mjs"
  },
  "dependencies": {
    "@storage-kit/cloudflare-durable-object-storage-host": "https://github.com/1amageek/storage-kit/releases/download/26.0817.0/storage-kit-cloudflare-durable-object-storage-host-26.817.0.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260817.1",
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
